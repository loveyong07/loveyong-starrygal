{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "loveyong-opengal",
  "version": "0.1.0",
  "identifier": "top.loveyong.opengal",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "loveyong-opengal · 你的故事收藏馆",
        "width": 1600,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [],
          "requireLiteralLeadingDot": false
        }
      }
    }
  },
  "bundle": {
    "license": "GPL-3.0-only",
    "licenseFile": "../LICENSE",
    "active": true,
    "targets": "all",
    "windows": {
      "wix": {
        "language": "zh-CN",
        "upgradeCode": "3A103816-43E1-442A-A93F-F2BAE3496ACD"
      },
      "nsis": {
        "languages": [
          "SimpChinese"
        ]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": false
  },
  "plugins": {}
}
