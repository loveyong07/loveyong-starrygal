{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StarryGal",
  "version": "0.2.1",
  "identifier": "top.loveyong.opengal",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "StarryGal · 你的故事收藏馆",
        "width": 1280,
        "height": 720,
        "minWidth": 1100,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "maximizable": true,
        "maximized": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [],
          "requireLiteralLeadingDot": false
        }
      }
    }
  },
  "bundle": {
    "license": "GPL-3.0-only",
    "licenseFile": "../LICENSE",
    "active": true,
    "targets": [
      "nsis"
    ],
    "windows": {
      "wix": {
        "language": "zh-CN",
        "upgradeCode": "3A103816-43E1-442A-A93F-F2BAE3496ACD"
      },
      "nsis": {
        "languages": [
          "SimpChinese"
        ],
        "installMode": "currentUser",
        "startMenuFolder": "StarryGal"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": false,
    "publisher": "loveyong07",
    "homepage": "https://github.com/loveyong07/loveyong-starrygal"
  },
  "plugins": {}
}
